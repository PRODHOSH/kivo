    <PackageReference Include="System.Speech" Version="10.0.12" />
  </ItemGroup>
  
  <ItemGroup>
    <Resource Include="duck.png" />
    <Resource Include="..\spirit.png" Link="spirit.png" />
  </ItemGroup>

</Project>
