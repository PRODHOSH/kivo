<Window x:Class="Kivo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        Title="Kivo" Height="85" Width="470"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        Topmost="True"
        Icon="pack://application:,,,/spirit.png"
        WindowStyle="None">
    
    <Window.Resources>
        <Storyboard x:Key="DotPulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" BeginTime="0:0:0.2" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.6" BeginTime="0:0:0.4" AutoReverse="True" />
        </Storyboard>
        

    </Window.Resources>
    
    <Border CornerRadius="20" Background="#F2181818" MouseLeftButtonDown="Border_MouseLeftButtonDown" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="4" Opacity="0.4"/>
        </Border.Effect>
        <StackPanel Margin="5">
            
            <!-- Widget Input Bar (Always visible) -->
            <Grid Height="56">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Image Source="pack://application:,,,/spirit.png" Width="48" Height="48" Margin="10,0,5,0" VerticalAlignment="Center" Grid.Column="0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                
                <TextBox x:Name="InputBox" Grid.Column="1" Height="36" Margin="5,0,0,0"
                         VerticalAlignment="Center" VerticalContentAlignment="Center" 
                         CaretBrush="White" FontSize="15"
                         ui:ControlHelper.PlaceholderText="Ask Kivo anything..." KeyDown="InputBox_KeyDown"
                         Background="Transparent" Foreground="White" BorderThickness="0" />
                
                <Button x:Name="MicButton" Grid.Column="2" Margin="5,0,5,0" Width="36" Height="36" 
                        Background="#252525" Foreground="White" BorderThickness="0" 
                        ui:ControlHelper.CornerRadius="18" Click="MicButton_Click" ToolTip="Voice Input">
                    <Grid>
                        <Path x:Name="MicIcon" Fill="White" Width="14" Height="18" Stretch="Uniform" 
                              Data="M8,12 C10.2,12 12,10.2 12,8 L12,4 C12,1.8 10.2,0 8,0 C5.8,0 4,1.8 4,4 L4,8 C4,10.2 5.8,12 8,12 Z M14,8 C14,11.3 11.3,14 8,14 C4.7,14 2,11.3 2,8 L0,8 C0,12 3.6,15.3 7,15.9 L7,19 L9,19 L9,15.9 C12.4,15.3 16,12 16,8 L14,8 Z" 
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        
                        <!-- Dot Pulse (Hidden by default) -->
                        <StackPanel x:Name="DotPulsePanel" Orientation="Horizontal" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot1" Width="5" Height="5" Fill="#10B981" Margin="1.5"/>
                            <Ellipse x:Name="Dot2" Width="5" Height="5" Fill="#10B981" Margin="1.5"/>
                            <Ellipse x:Name="Dot3" Width="5" Height="5" Fill="#10B981" Margin="1.5"/>
                        </StackPanel>
                    </Grid>
                </Button>
                
                <Button x:Name="ExpandButton" Grid.Column="3" Margin="0,0,5,0" Width="36" Height="36" 
                        Background="Transparent" Foreground="White" BorderThickness="0" 
                        ui:ControlHelper.CornerRadius="18" Click="ExpandButton_Click" ToolTip="Toggle Chat">
                    <Path x:Name="ExpandIcon" Fill="White" Width="12" Height="8" Stretch="Uniform"
                          Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z" 
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                
                <Button x:Name="CloseButton" Grid.Column="4" Margin="0,0,10,0" Width="36" Height="36" 
                        Background="Transparent" Foreground="#FF5555" BorderThickness="0" 
                        ui:ControlHelper.CornerRadius="18" Click="CloseButton_Click" ToolTip="Close Kivo">
                    <Path Fill="#FF5555" Width="10" Height="10" Stretch="Uniform"
                          Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
            
            <!-- Chat Area (Collapsible) -->
            <ScrollViewer x:Name="ChatScrollViewer" Visibility="Collapsed" Height="340" Margin="10,10,10,10" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChatPanel">
                </StackPanel>
            </ScrollViewer>
            
        </StackPanel>
    </Border>
</Window>
